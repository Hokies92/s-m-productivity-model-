{
  "model_metadata": {
    "name": "Sales Capacity Model",
    "version": "2.1",
    "original_creation_date": "2000",
    "audit_date": "2003",
    "auditor": "Ernst & Young",
    "documentation_date": "2026",
    "subtitle": "A Cognitive-Temporal Throughput Model for Sales Effectiveness",
    "spec_revision_note": "v2.1 reconciles the spec to the workbook formulas (source/workbook_cells.csv). See AUDIT_FINDINGS.md.",
    "workbook_label": "Sales and Marketing Efficiency Model (2011 edition); originated 2000 by Scott Santucci",
    "owner": "Growth Enablement",
    "copyright": "Copyright (c) 2000-2026 Growth Enablement. All rights reserved.",
    "status": "As-is reference: describes the original workbook and its exact reproduction. Target design: docs/DATA_MODEL_REQUIREMENTS.md and docs/MODEL_UNDERSTANDING.md."
  },
  "foundational_premise": {
    "core_assertion": "Sales capacity is not labor hours. It is cognitive bandwidth constrained by time.",
    "conventional_assumption": {
      "description": "Capacity equals labor",
      "implication": "Linear scaling - double the reps, double the output",
      "validity": "Empirically false"
    },
    "failure_reason": "The constraint on sales output is not hours available. It is attention deployable.",
    "two_ceilings": {
      "ceiling_1": {
        "name": "Cognitive Load Limit",
        "description": "A human can only hold so many complex situations in active memory simultaneously",
        "nature": "Fixed by cognitive architecture, not by effort or motivation",
        "implication": "Working harder does not expand this ceiling"
      },
      "ceiling_2": {
        "name": "Resolution Time",
        "description": "Deals take elapsed time to close",
        "nature": "Primarily the customer's decision process duration, not the salesperson's time",
        "implication": "The salesperson cannot unilaterally accelerate this without degrading conversion quality"
      }
    },
    "fundamental_equation": {
      "formula": "Capacity = Cognitive Load Limit × Time Velocity",
      "components": {
        "cognitive_load_limit": "Maximum opportunities a rep can simultaneously track, understand, and advance",
        "time_velocity": "Number of times per year that cognitive inventory turns over (12 ÷ sales cycle months)"
      }
    }
  },
  "ontology": {
    "key_distinction": "This model uses familiar sales terminology with non-standard definitions",
    "territory_headcount_separation": {
      "conventional_model": "Territory = Headcount = Capacity",
      "this_model": "Territory ≠ Headcount ≠ Capacity"
    },
    "terms": {
      "capacity": {
        "conventional_meaning": "Headcount or quota coverage",
        "model_meaning": "Cognitive bandwidth × time availability"
      },
      "territory": {
        "conventional_meaning": "Geographic or account assignment",
        "model_meaning": "A workload container independent of the person assigned"
      },
      "rep": {
        "conventional_meaning": "Labor cost unit",
        "model_meaning": "A processing system with cognitive constraints"
      },
      "time": {
        "conventional_meaning": "Calendar duration (weeks to close)",
        "model_meaning": "A finite resource that bounds throughput"
      },
      "quota": {
        "conventional_meaning": "Revenue target to hit",
        "model_meaning": "Output expectation (may or may not align with capacity physics)"
      },
      "leads": {
        "conventional_meaning": "Inputs to the sales process",
        "model_meaning": "Not in this model - constraint is processing capacity, not input volume"
      }
    },
    "leads_exclusion_rationale": {
      "reason": "Output is constrained by processing capacity, not input volume",
      "example": "If a rep can hold 30 opportunities and cycle is 6 months, max is 60/year regardless of lead volume",
      "excess_leads_outcomes": [
        "Get ignored (waste)",
        "Get worked poorly, degrading close rate",
        "Create cognitive overload, extending cycle time"
      ],
      "conclusion": "More leads hit a ceiling that is already in this model"
    }
  },
  "mathematical_framework": {
    "throughput_chain": {
      "step_1": {
        "name": "Maximum Opportunities Per Year",
        "formula": "Max_Opportunities = Manageable_Opportunities × (12 ÷ Sales_Cycle_Months)",
        "example": {
          "calculation": "30 × (12 ÷ 6) = 60",
          "result": "60 opportunities/year"
        },
        "logic": "Cognitive capacity multiplied by inventory turns per year"
      },
      "step_2": {
        "name": "Deals Closed Per Year",
        "formula": "Deals_Closed = Max_Opportunities × Close_Rate",
        "example": {
          "calculation": "60 × 0.25 = 15",
          "result": "15 deals/year per rep"
        },
        "logic": "Throughput capacity filtered by conversion quality"
      },
      "step_3": {
        "name": "Revenue Per Rep",
        "formula": "Revenue_Per_Rep = Deals_Closed × Avg_Deal_Size",
        "example": {
          "calculation": "15 × $75,000 = $1,125,000",
          "result": "$1,125,000/year"
        },
        "logic": "Deals converted to revenue at average transaction value"
      },
      "step_4": {
        "name": "Total Revenue",
        "formula": "Total_Revenue = Revenue_Per_Rep × Number_of_Territories",
        "example": {
          "calculation": "$1,125,000 × 100 = $112,500,000",
          "result": "$112,500,000"
        },
        "logic": "Per-rep output scaled by number of parallel processors (territories)"
      },
      "step_5": {
        "name": "Total Cost Per Rep",
        "formula": "Cost_Per_Rep = Fully_Loaded_Salary + Travel_Costs + (Revenue_Per_Rep × Commission_Rate)",
        "example": {
          "calculation": "$87,750 + $47,500 + ($1,125,000 × 0.08) = $225,250",
          "result": "$225,250"
        },
        "logic": "Fixed costs plus variable (commission tied to revenue produced)"
      }
    },
    "four_levers": {
      "lever_1": {
        "name": "Decrease Cycle Time",
        "what_it_changes": "Time velocity (12 ÷ months)",
        "mathematical_effect": "Increases opportunities per year",
        "constraint_type": "Removes temporal bottleneck",
        "cost_behavior": "Does not proportionally increase cost"
      },
      "lever_2": {
        "name": "Increase Close Rate",
        "what_it_changes": "Conversion yield",
        "mathematical_effect": "More deals from same opportunities",
        "constraint_type": "Improves throughput quality",
        "cost_behavior": "Does not proportionally increase cost"
      },
      "lever_3": {
        "name": "Increase Deal Size",
        "what_it_changes": "Revenue per conversion",
        "mathematical_effect": "More value per closed deal",
        "constraint_type": "Increases value density",
        "cost_behavior": "Does not proportionally increase cost"
      },
      "lever_4": {
        "name": "Add Territories",
        "what_it_changes": "Parallel processors",
        "mathematical_effect": "Linear scale",
        "constraint_type": "Adds parallel capacity",
        "cost_behavior": "Costs scale linearly with output"
      }
    },
    "critical_observation": "The first three levers improve output without proportionally increasing cost. The fourth lever increases both output and cost linearly. Quality-based levers outperform quantity-based levers on margin."
  },
  "worksheets": {
    "worksheet_1_data_entry": {
      "purpose": "Captures the baseline state of the sales organization. All values entered here flow through to subsequent worksheets as inputs for calculations.",
      "input_categories": {
        "individual_sales_rep_data": {
          "number_of_territories": {
            "description": "Count of open territories (not headcount)",
            "default_value": 100,
            "cell_reference": "E8",
            "unit": "count"
          },
          "average_revenue_per_transaction": {
            "description": "Mean deal size",
            "default_value": 75000,
            "cell_reference": "E10",
            "unit": "dollars"
          },
          "average_fully_loaded_salary": {
            "description": "Base salary × (1 + corporate load rate)",
            "default_value": 116850,
            "cell_reference": "E14",
            "unit": "dollars/year",
            "sub_inputs": {
              "base_salary": {
                "default_value": 95000,
                "cell_reference": "E15"
              },
              "corporate_load_rate": {
                "default_value": 0.23,
                "cell_reference": "E16"
              }
            },
            "formula": "Base_Salary × (1 + Load_Rate)",
            "example_calculation": "$95,000 × (1 + 0.23) = $116,850",
            "note": "Entered value (116,850) is NOT used downstream. Performance Breakdown hard-codes 87,750. See finding F1."
          },
          "average_travel_costs_per_rep": {
            "description": "Annual travel expense per rep",
            "default_value": 47500,
            "cell_reference": "E18",
            "unit": "dollars/year",
            "formula": "(Airfare + Ground_Transport + (Meals × Days) + (Lodging × Days) + Entertainment) × Trips_Per_Year",
            "sub_inputs": {
              "airfare": {
                "default_value": 750
              },
              "ground_transport": {
                "default_value": 200
              },
              "meals_per_day": {
                "default_value": 100
              },
              "lodging_per_night": {
                "default_value": 250
              },
              "days_per_trip": {
                "default_value": 2
              },
              "entertainment_per_trip": {
                "default_value": 250
              },
              "trips_per_year": {
                "default_value": 25
              }
            },
            "example_calculation": "($750 + $200 + ($100 × 2) + ($250 × 2) + $250) × 25 = $47,500"
          },
          "commission_rate": {
            "description": "Percentage of revenue paid as commission",
            "default_value": 0.08,
            "cell_reference": "E27",
            "unit": "percentage"
          },
          "unused_inputs": {
            "number_of_contracts_last_year": 755,
            "revenue_from_those_contracts": 25000000,
            "note": "Entered but not referenced by any formula. 25,000,000 / 755 = 33,113, which does not match the 75,000 deal size used."
          }
        },
        "sales_mechanics": {
          "manageable_opportunities": {
            "description": "Cognitive load limit - number of opportunities a rep can effectively manage simultaneously",
            "default_value": 30,
            "cell_reference": "E30",
            "unit": "count"
          },
          "sales_cycle_length": {
            "description": "Average time from first meeting to close",
            "default_value": 6,
            "cell_reference": "E32",
            "unit": "months"
          },
          "sales_ramp_up_time": {
            "description": "Time for new rep to reach full productivity",
            "default_value": 12,
            "cell_reference": "E34",
            "unit": "months",
            "note": "IS used: only in the territory scenarios. New territories earn (12 - ramp)/12 of a year of revenue. At 12 months that is zero. See findings F2, F3."
          },
          "close_rate": {
            "description": "Percentage of worked opportunities that convert",
            "default_value": 0.25,
            "cell_reference": "E36",
            "unit": "percentage"
          }
        },
        "overhead_and_marketing": {
          "sales_overhead_costs": {
            "description": "Sum of non-variable sales expenses",
            "default_value": 10800000,
            "cell_reference": "E40",
            "unit": "dollars",
            "sub_components": {
              "non_quota_manager_salaries": {
                "default_value": 2750000
              },
              "sales_engineers": {
                "default_value": 6000000
              },
              "sales_admin": {
                "default_value": 800000
              },
              "training_costs": {
                "default_value": 500000
              },
              "incentive_costs": {
                "default_value": 750000
              }
            }
          },
          "marketing_costs": {
            "description": "Sum of all marketing investments",
            "default_value": 3700000,
            "cell_reference": "E47",
            "unit": "dollars",
            "sub_components": {
              "marketing_personnel": {
                "default_value": 1000000
              },
              "website": {
                "default_value": 250000
              },
              "events": {
                "default_value": 500000
              },
              "advertising": {
                "default_value": 500000
              },
              "direct_mail": {
                "default_value": 250000
              },
              "telemarketing": {
                "default_value": 250000
              },
              "branding_pr": {
                "default_value": 200000
              },
              "collateral": {
                "default_value": 750000
              }
            }
          },
          "total_sales_and_marketing_costs": {
            "description": "Overhead + Marketing",
            "default_value": 14500000,
            "cell_reference": "E38",
            "unit": "dollars",
            "formula": "Sales_Overhead_Costs + Marketing_Costs"
          }
        }
      }
