    "worksheet_2_performance_breakdown": {
      "purpose": "The analytical engine of the model. Computes throughput, applies scenario variations, and projects outcomes. This is where the cognitive-temporal capacity logic is executed.",
      "structure": {
        "column_B": {
          "name": "Baseline",
          "description": "Current state values from Data Entry"
        },
        "columns_D_G": {
          "name": "Individual Scenarios",
          "description": "Each lever tested independently at 10% improvement"
        },
        "columns_I_J": {
          "name": "Combined Scenarios",
          "description": "Multiple levers applied simultaneously"
        }
      },
      "scenario_inputs": {
        "row": 6,
        "scenarios": {
          "column_D": {
            "name": "Hire more sales people",
            "default_adjustment": 0.1,
            "adjustment_direction": "increase"
          },
          "column_E": {
            "name": "Increase close rate",
            "default_adjustment": 0.1,
            "adjustment_direction": "increase"
          },
          "column_F": {
            "name": "Decrease sales cycle time",
            "default_adjustment": 0.1,
            "adjustment_direction": "decrease"
          },
          "column_G": {
            "name": "Increase average revenue/transaction",
            "default_adjustment": 0.1,
            "adjustment_direction": "increase"
          },
          "column_I": {
            "name": "Combined: Close + Deal Size + Cycle",
            "default_adjustment": "per individual scenario",
            "actual_columns": "Workbook column J (territories held at baseline)"
          },
          "column_J": {
            "name": "Improve all scenarios",
            "default_adjustment": "all at 10%",
            "actual_columns": "Workbook column K"
          }
        }
      },
      "core_calculations": {
        "max_opportunities_per_year": {
          "row": 20,
          "formula": "Manageable_Opportunities × (12 / Sales_Cycle_Months)",
          "baseline_result": 60,
          "cycle_scenario_result": 66.67,
          "significance": "Critical constraint equation. 10% cycle reduction (6 → 5.4 months) increases opportunities by 11.1%"
        },
        "deals_closed_per_year": {
          "row": 21,
          "formula": "Max_Opportunities × Close_Rate",
          "baseline_result": 15,
          "close_rate_scenario_result": 16.5
        },
        "revenue_per_rep": {
          "row": 22,
          "formula": "Deals_Closed × Avg_Deal_Size",
          "baseline_result": 1125000,
          "deal_size_scenario_result": 1237500
        },
        "commission": {
          "row": 12,
          "formula": "Revenue_Per_Rep × Commission_Rate",
          "baseline_result": 90000,
          "note": "Variable cost - higher revenue scenarios automatically increase commission costs"
        },
        "total_cost_per_rep": {
          "row": 13,
          "formula": "Fully_Loaded_Salary + Travel_Costs + Commission",
          "baseline_result": 225250,
          "note": "Uses hard-coded 87,750 salary, not the Data Entry 116,850 (F1)."
        },
        "total_revenue": {
          "row": 24,
          "formula": "Revenue_Per_Rep × Number_of_Territories",
          "baseline_result": 112500000,
          "scenario_variants": {
            "hire": "=((12-Ramp)/12 * New_Territories * Rev_Per_Rep) + Baseline_Revenue  -> new reps produce 0 in year 1 at 12-month ramp",
            "improve_all": "=(T_new * Rev_Per_Rep_new) - ((12-Ramp)/12 * New_Territories * Rev_Per_Rep_base)  -> subtracts 0 at 12-month ramp, so new reps get full-year credit (F3)"
          }
        },
        "total_sales_rep_costs": {
          "row": 25,
          "formula": "Cost_Per_Rep × Number_of_Territories",
          "baseline_result": 22525000
        }
      }
    },
    "worksheet_3_impact_analysis": {
      "purpose": "Translates throughput changes into income statement impact. Connects operational physics to financial outcomes.",
      "sections": {
        "revenue": {
          "total_revenues": {
            "row": 7,
            "source": "Worksheet 2, Row 24",
            "baseline": 112500000
          },
          "increase_from_base": {
            "row": 8,
            "formula": "Scenario_Revenue - Baseline_Revenue",
            "example": {
              "scenario": "Close Rate",
              "calculation": "$123,750,000 - $112,500,000 = $11,250,000"
            }
          }
        },
        "costs": {
          "increase_in_sales_costs": {
            "row": 11,
            "formula": "Scenario_Sales_Rep_Costs - Baseline_Sales_Rep_Costs",
            "note": "Quality-lever scenarios show smaller cost increases than quantity-lever scenarios"
          },
          "total_sales_costs": {
            "row": 12,
            "formula": "Sales_Rep_Costs + Sales_Overhead_Costs",
            "baseline": 33325000
          },
          "total_marketing_costs": {
            "row": 13,
            "baseline": 3700000
          },
          "total_sales_and_marketing_costs": {
            "row": 14,
            "formula": "Total_Sales_Costs + Marketing_Costs",
            "baseline": 37025000
          }
        },
        "operating_expenses": {
          "cost_of_revenue": {
            "row": 17,
            "percentage_of_revenue": 0.1322,
            "baseline": 14872500,
            "source": "Industry average"
          },
          "research_and_development": {
            "row": 18,
            "percentage_of_revenue": 0.1019,
            "baseline": 11463750,
            "source": "Industry average"
          },
          "sales_and_marketing": {
            "row": 19,
            "calculation": "calculated from model",
            "baseline": 37025000
          },
          "general_and_administrative": {
            "row": 20,
            "percentage_of_revenue": 0.154,
            "baseline": 17325000,
            "source": "Industry average"
          },
          "total_operating_expenses": {
            "row": 21,
            "formula": "Cost_of_Revenue + R&D + S&M + G&A",
            "baseline": 80686250
          },
          "operating_income": {
            "row": 22,
            "formula": "Total_Revenue - Total_Operating_Expenses",
            "baseline": 31813750
          }
        },
        "metrics": {
          "percentage_net_gain": {
            "row": 26,
            "formula": "(Scenario_Revenue - Baseline_Revenue - (Scenario_Sales_Costs - Baseline_Sales_Costs)) / Baseline_Revenue",
            "excel": "=(E9-E12)/'2) Performance breakdown'!$C$25",
            "significance": "Key comparison metric. Measures incremental gross contribution after sales cost, as a share of baseline revenue. Excludes the revenue-linked COGS/R&D/G&A growth (F4)."
          },
          "sales_and_marketing_roi": {
            "row": 27,
            "formula": "(Total_Revenue - Total_S&M_Costs) / Total_S&M_Costs",
            "baseline": 2.0385,
            "interpretation": "Net revenue return per S&M dollar (F5)"
          }
        }
      }
    },
    "worksheet_4_scenario_diagnostics": {
      "purpose": "Translates mathematical results into operational guidance. Identifies common obstacles that prevent organizations from achieving improvements in each lever.",
      "key_insight": "Knowing which lever to pull is different from being able to pull it",
      "structure_note": "Hire more sales people deliberately excluded - model demonstrates it's the least effective lever",
      "diagnostics": {
        "increase_close_rate": {
          "obstacles": [
            {
              "number": 1,
              "obstacle": "Sales people unable to have relevant dialog with key stakeholders",
              "root_cause": "Lack of business context training; product-centric not outcome-centric"
            },
            {
              "number": 2,
              "obstacle": "Client does not understand proposed value",
              "root_cause": "Feature-focused selling; failure to translate to client's context"
            },
            {
              "number": 3,
              "obstacle": "Product does not meet market needs",
              "root_cause": "Solution built for one context applied to different contexts"
            },
            {
              "number": 4,
              "obstacle": "Out-positioned by competitor",
              "root_cause": "Failure to influence requirements definition early in cycle"
            },
            {
              "number": 5,
              "obstacle": "No defensible business case",
              "root_cause": "Economic justification not established; competing against other internal projects"
            }
          ]
        },
        "decrease_cycle_time": {
          "obstacles": [
            {
              "number": 1,
              "obstacle": "Lack of understanding for customer's problem-solving lifecycle",
              "root_cause": "Salesperson's process misaligned with buyer's process"
            },
            {
              "number": 2,
              "obstacle": "Solution complexity is overwhelming",
              "root_cause": "Client cannot see clear path from current state to future state"
            },
            {
              "number": 3,
              "obstacle": "Sponsor has difficulty selling internally",
              "root_cause": "Champion not equipped with internal selling tools"
            },
            {
              "number": 4,
              "obstacle": "Client confusion about technology/approach/value",
              "root_cause": "Jargon-driven selling; lack of clarity"
            },
            {
              "number": 5,
              "obstacle": "Client lacks urgency",
              "root_cause": "No compelling event; unclear cost of inaction"
            }
          ]
        },
        "increase_revenue_per_transaction": {
          "obstacles": [
            {
              "number": 1,
              "obstacle": "Poor negotiation",
              "root_cause": "Desperation at end of quarter; professional buyers exploit this"
            },
            {
              "number": 2,
              "obstacle": "Product features don't match perceived value",
              "root_cause": "Features optimized for competitive checklist, not customer value"
            },
            {
              "number": 3,
              "obstacle": "Management desperation to close quarterly revenue",
              "root_cause": "Inadequate pipeline management; late visibility into shortfalls"
            },
            {
              "number": 4,
              "obstacle": "Economic ROI not established",
              "root_cause": "Failure to defend price with quantified value"
            },
            {
              "number": 5,
              "obstacle": "Pricing doesn't align to customer's value received",
              "root_cause": "Pricing model disconnected from how customer realizes benefits"
            }
          ]
        }
      }
    }
  },
  "model_interconnections": {
    "data_flow": {
      "stage_1": {
        "worksheet": "Data Entry",
        "outputs": [
          "Territories",
          "Salary",
          "Travel",
          "Commission",
          "Mechanics",
          "Overhead",
          "Marketing"
        ]
      },
      "stage_2": {
        "worksheet": "Performance Breakdown",
        "inputs_from": "Data Entry",
        "process": "Applies capacity logic → Computes throughput → Projects by scenario",
        "outputs": [
          "Revenue by scenario",
          "Costs by scenario"
        ]
      },
      "stage_3": {
        "worksheet": "Impact Analysis",
        "inputs_from": "Performance Breakdown",
        "process": "Translates to income statement → Computes operating income → Calculates ROI",
        "outputs": [
          "Operating Income",
          "Net Gain %",
          "S&M ROI"
        ]
      },
      "stage_4": {
        "worksheet": "Scenario Diagnostics",
        "inputs_from": "Impact Analysis results",
        "process": "Interprets results → Identifies obstacles → Guides implementation",
        "outputs": [
          "Operational guidance"
        ]
      }
    },
